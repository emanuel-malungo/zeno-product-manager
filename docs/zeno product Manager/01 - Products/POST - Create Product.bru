meta {
  name: POST - Create Product
  type: http
  seq: 3
}

post {
  url: {{BASE_URL}}/api/products?user={{USER_ID}}
  body: json
  auth: inherit
}

params:query {
  user: {{USER_ID}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "iPhone 15",
    "description": "Smartphone Apple",
    "price": 850000,
    "stock": 10,
    "user": "{{USER_ID}}"
  }
}
